{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_request",
        "new_offer",
        "offer_approved",
        "offer_rejected",
        "offer_accepted",
        "chat_message",
        "review_received",
        "verification_approved",
        "verification_rejected",
        "system"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ]
}