      "type": "string"
    },
    "name_fr": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "ai_pricing_context": {
      "type": "string"
    },
    "min_price_cad": {
      "type": "number"
    },
    "max_price_cad": {
      "type": "number"
    }
  },
  "required": [
